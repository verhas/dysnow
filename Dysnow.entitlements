<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Distributed with a Developer ID outside the Mac App Store, the same
	     way Irctell is, so the App Sandbox is off. Switching it on later
	     needs com.apple.security.network.client for the model download and
	     com.apple.security.files.user-selected.read-write for open and save. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
